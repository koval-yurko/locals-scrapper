# Database connection string for local development
DATABASE_URL=postgresql://test:test@localhost:5434/locals-scrapper

# Base URL for API endpoints
BASE_URL=/api

# Access token for Locals API - KEEP SECRET!
# Get this from your Locals account dashboard
LOCALS_ACCESS_TOKEN=your_locals_access_token_here

# JWT discovery URL for authentication
# Example: https://your-supabase-project.supabase.co/auth/v1/jwks
JWT_DISCOVERY_URL=https://your-project.supabase.co/auth/v1/jwks

# Comma-separated list of valid API keys for authentication - KEEP SECRET!
# Generate secure random strings for production use
VALID_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3
