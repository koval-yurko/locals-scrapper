# AWS CDK Configuration - KEEP ALL VALUES SECRET!

# AWS Account and Region
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=eu-central-1

# Domain and SSL Configuration
DOMAIN_NAME=your-domain.com
HOSTED_ZONE_ID=Z1234567890ABC
CERTIFICATE_ARN=arn:aws:acm:region:account:certificate/certificate-id

# Database URLs - Use secure connection strings
DATABASE_DEV_URL=postgresql://username:password@dev-host:5432/database?sslmode=require
DATABASE_PROD_URL=postgresql://username:password@prod-host:5432/database?sslmode=require

# API Tokens and Keys - Generate secure random values
LOCALS_ACCESS_TOKEN=your_locals_api_token_here
VALID_API_KEYS=secure_api_key_1,secure_api_key_2,secure_api_key_3

# JWT Secret for Supabase - Use a strong secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

JWT_KEYS_ISSUER=
JWT_KEYS_AUDIENCE=
