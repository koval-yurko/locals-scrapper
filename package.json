{
  "name": "locals-scrapper-infra",
  "version": "0.1.0",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:go": "GOOS=linux GOARCH=arm64 go build -tags lambda.norpc -o ./dist/lambda/user-fetch-go/bootstrap ./lambda/user-fetch-go/main.go",
    "dev": "nodemon lambda/server-app/dev.ts",
    "dev:setup": "docker-compose up -d && npm run setup-localstack",
    "dev:debug": "ts-node lambda/server-app/dev.ts",
    "dev:lambda": "ts-node lambda/user-fetch/dev.ts",
    "dev:lambda:debug": "ts-node lambda/user-fetch/dev.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . ",
    "format": "prettier --write .",
    "cdk:synth": "cdk synth",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:deploy:dev": "npm run build && npm run build:go && AWS_REGION=eu-central-1 cdk deploy LocalsScrapperDevStack",
    "cdk:deploy:prod": "npm run build && npm run build:go && AWS_REGION=eu-central-1 cdk deploy LocalsScrapperProdStack",
    "cdk:destroy": "cdk destroy --all",
    "prisma:generate": "prisma generate",
    "prisma:go:prefetch": "go run github.com/steebchen/prisma-client-go prefetch",
    "postinstall": "npm run prisma:generate",
    "openapi:generate:old": "ts-node ./scripts/generateOpenAPI.ts",
    "openapi:generate": "npm run openapi:generate:routes && npm run openapi:generate:spec",
    "openapi:generate:routes": "tsoa routes -c lambda/server-app/tsoa.json",
    "openapi:generate:spec": "tsoa spec -c lambda/server-app/tsoa.json",
    "setup-localstack": "./scripts/setup-localstack.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/aws-lambda": "^8.10.146",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/node": "22.7.9",
    "aws-cdk": "2.173.2",
    "aws-cdk-lib": "2.173.2",
    "constructs": "^10.0.0",
    "esbuild": "^0.24.2",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.17.0",
    "fs-extra": "^11.2.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsoa": "^6.6.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.716.0",
    "@prisma/client": "^6.1.0",
    "@prisma/extension-accelerate": "^1.2.1",
    "aws-lambda": "^1.0.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "serverless-http": "^3.2.0"
  },
  "prisma": {
    "schema": "./shared/repositories/prisma/schema.prisma"
  }
}
